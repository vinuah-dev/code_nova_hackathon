# Copy to .env and fill in ONE option. Never commit .env.
# With no key at all, Inkloom runs in "Rule engine" mode (deterministic checks only).

# --- Option A (FREE): Google Gemini via Google AI Studio (aistudio.google.com -> Get API key)
INKLOOM_AI_PROVIDER=gemini
GEMINI_API_KEY=
# INKLOOM_MODEL=gemini-3.5-flash

# --- Option B: Anthropic Claude (paid API credits)
# INKLOOM_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# INKLOOM_MODEL=claude-opus-5-5
# INKLOOM_EFFORT=medium

# --- Option C (FREE key): Groq / OpenRouter
# INKLOOM_AI_PROVIDER=groq            # or openrouter
# INKLOOM_AI_API_KEY=
# INKLOOM_MODEL=                      # optional override

# --- Option D (FREE, offline, private): Ollama on this laptop (ollama pull llama3.2-vision)
# INKLOOM_AI_PROVIDER=ollama
# INKLOOM_AI_IMAGES=1                 # set 0 for text-only models

# --- Any other OpenAI-compatible server
# INKLOOM_AI_PROVIDER=openai-compatible
# INKLOOM_AI_BASE_URL=http://host:port/v1
# INKLOOM_AI_API_KEY=
# INKLOOM_MODEL=

INKLOOM_PORT=8000

# Sign-in (optional)
# INKLOOM_DEMO_PASSWORD=voltaro-demo   # password for the seeded demo accounts (set before first start)
# INKLOOM_DEMO_LOGIN=0                 # hide the one-click demo account buttons
